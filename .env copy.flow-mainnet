# app configuration
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_APP_PORT=3000

# blockchain parameters
NEXT_PUBLIC_NETWORK_NAME=Flow Mainnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=flow
NEXT_PUBLIC_NETWORK_ID=747
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=FLOW
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=FLOW
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE=validation
NEXT_PUBLIC_NETWORK_RPC_URL=https://mainnet.evm.nodes.onflow.org

# api configuration
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_HOST=localhost
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_PORT=3001

# branding
# NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG={'background':['radial-gradient(103.03% 103.03% at 0% 0%, rgba(0, 0, 255, 0.67) 0%, rgb(0, 0, 255) 100%)']}
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_FONT_FAMILY_BODY="Inter"
NEXT_PUBLIC_FONT_FAMILY_HEADING="Inter"
NEXT_PUBLIC_COLOR_THEME_DEFAULT="light"
NEXT_PUBLIC_NETWORK_LOGO=""
NEXT_PUBLIC_NETWORK_ICON=""
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false

# Metadata
NEXT_PUBLIC_OG_IMAGE_URL=""
NEXT_PUBLIC_OG_DESCRIPTION="Explore transactions, accounts, blocks, gas fees and other network activity within the Flow EVM blockchain."
NEXT_PUBLIC_OG_ENHANCED_DATA_ENABLED=true
NEXT_PUBLIC_SEO_ENHANCED_DATA_ENABLED=true

# wallets
NEXT_PUBLIC_WEB3_WALLETS=['metamask']
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID='bab82e3cd123222168fc8a7e2043171c'
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID='59fc763f27e139680332004f06538784'

# gas tracker
NEXT_PUBLIC_GAS_TRACKER_ENABLED=true
